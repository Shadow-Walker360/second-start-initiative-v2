# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.secondstartinitiative.org

# Base URL of the Second Start Initiative backend API.
# Required for the Volunteer, Get Involved, and Donate forms to submit.
# Leave unset in an environment with no backend yet — forms will show a
# clear "can't reach the server" message instead of failing silently.
NEXT_PUBLIC_API_URL=https://api.secondstartinitiative.org
